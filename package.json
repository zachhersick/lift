    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@neondatabase/serverless": "1.0.2",
