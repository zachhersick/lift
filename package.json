    "start": "node scripts/build-web.mjs && node scripts/dev.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@preact/signals": "2.2.1",
    "htm": "3.1.1",
    "preact": "10.26.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "engines": {
    "node": ">=20"
  },
