{
  "name": "lift",
  "version": "1.0.0",
  "private": true,
  "description": "A workout tracker for your gym split: log sets, weight and reps, and watch progressive overload.",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
